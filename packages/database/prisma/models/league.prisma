enum Region {
  BR1
  EUN1
  EUW1
  KR
  LA1
  LA2
  NA1
  OC1
  TR1
  RU
  JP1
  VN2
  TW2
  SG2
  ME1
  PBE1
}

model LeagueAccount {
  discordId    String
  riotPuuid    String  @id @db.VarChar(78)
  riotGamename String?
  riotTagline  String?
  region       Region
  /// [RankedData]
  leaguedata   Json?
  /// [RankedData]
  tftdata      Json?

  @@map("league_accounts")
}
