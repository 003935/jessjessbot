{
	"name": "@repo/database",
	"private": true,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./utils": {
			"types": "./src/utils.ts",
			"default": "./src/utils.ts"
		}
	},
	"scripts": {
		"db:generate": "bunx --bun prisma generate",
		"db:migrate": "bunx --bun prisma migrate dev",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.7.0",
		"@prisma/client": "^7.7.0",
		"@types/pg": "^8.20.0",
		"pg": "^8.20.0"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^25.6.0",
		"prisma": "^7.7.0",
		"prisma-json-types-generator": "^4.1.1",
		"twisted": "^1.72.2",
		"typescript": "^5.9.3"
	}
}
