{
  "extends": [
    "./base.json"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "isolatedModules": true,
    "module": "ESNext",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "target": "esnext"
  },
  "exclude": [
    "node_modules"
  ]
}
