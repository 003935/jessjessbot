{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "bot:start": {
      "cache": false
    },
    "dash:dev": {
      "cache": false,
      "persistent": true
    },
    "dash:prepare": {
      "cache": false
    },
    "dash:build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".svelte-kit/**",
        ".vercel/**"
      ]
    }
  }
}
