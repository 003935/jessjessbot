# Discord Server Configuration
ROLE_ID=

# Discord Bot Credentials
BOT_TOKEN=
CLIENT_ID=

# Wordle Bot ID
BOT_ID=

# RIOT API
RIOT_API_KEY=

# Optional: enable chat, /tldr, and image replies via OpenCode Go
# (service account key oc_sk_... from https://opencode.ai/console > Keys)
OPENCODE_API_KEY=
# OPENCODE_MODEL=deepseek-v4.1-flash

# Optional: pet photo recognition still uses the DeepSeek Files API
DEEPSEEK_API_KEY=

# Database
DATABASE_URL=""
DIRECT_URL=""

# OMDB
OMDB_API_KEY=""

# Optional: react with 🔥 to images/videos on this channel
YUM_CHANNEL_ID=

# Optional: react with ❤️ to images on this channel
PET_CHANNEL_ID=

# Daily random @kadeem1111 tweet (Europe/London). Requires a running bot.
DAILY_TWEETS_ENABLED=false
GUILD_ID=
# Optional when the guild has exactly one text channel named general
GENERAL_CHANNEL_ID=
# X auth_token session cookie; keep private
X_AUTH_TOKEN=
