# Discord Server Configuration
ROLE_ID=

# Discord Bot Credentials
BOT_TOKEN=
CLIENT_ID=

# Wordle Bot ID
BOT_ID=

# RIOT API
RIOT_API_KEY=

# Optional: set to true to allow /join and /leave once the OmniVoice server is running
VOICE_ENABLED=false

# Optional: local OmniVoice service used for voice replies in Discord VC
# (defaults to http://omnivoice:8080, the docker-compose service)
OMNIVOICE_URL=http://omnivoice:8080

# Optional: enable /tldr (recent channel messages are sent to DeepSeek)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Optional: use another OpenAI-compatible chat API instead of DeepSeek, e.g. OpenCode Go:
# CHAT_API_URL=https://opencode.ai/inference/go/v1/chat/completions
# CHAT_API_KEY=
# Everyday banter (fast). Defaults to DEEPSEEK_MODEL.
# CHAT_MODEL=
# Images, links, long answers, search results, and TL;DRs. Defaults to CHAT_MODEL.
# CHAT_DEEP_MODEL=
# Model for images; must accept image input. Defaults to CHAT_DEEP_MODEL.
# CHAT_VISION_MODEL=
# Reasoning effort: off, low, medium, or high. If a model rejects reasoning, jjb retries without it.
# CHAT_REASONING_EFFORT=off
# CHAT_DEEP_REASONING_EFFORT=medium

# Optional: comma-separated literal words or phrases to block in bot replies (case-insensitive)
# OUTPUT_BLOCKED_WORDS=

# Optional: let jjb search the web (via Tavily) when chatting about current events or facts
TAVILY_API_KEY=

# Database
DATABASE_URL=""
DIRECT_URL=""

# Movie requests: TMDB search, OMDB for extra ratings
TMDB_API_KEY=""
OMDB_API_KEY=""

# Optional: Path of Exile loot league (defaults to the first league returned by the API)
POE_LOOT_LEAGUE=

# Optional: react with 🔥 to images/videos on this channel
YUM_CHANNEL_ID=

# Optional: react with ❤️ to images on this channel
PET_CHANNEL_ID=

# Daily random @kadeem1111 tweet (Europe/London). Requires a running bot.
DAILY_TWEETS_ENABLED=false
GUILD_ID=
# Optional when the guild has exactly one text channel named general
GENERAL_CHANNEL_ID=
# X auth_token session cookie; keep private
X_AUTH_TOKEN=
