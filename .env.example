# Docker Compose secrets.
# Local: copy this file to .env in the repo root.
# Dokploy: paste these lines into the compose app's Environment tab.
#
# These two are all compose needs. It builds every database/valkey URL
# from them, so you don't need to set DATABASE_URL or VALKEY_URL in Dokploy.

# Must match the password the database was created with (currently mypassword).
# To change it later, also run inside the db container:
#   psql -U postgres -c "ALTER USER postgres PASSWORD 'new-password';"
POSTGRES_PASSWORD=mypassword

# Any random string, letters and numbers only (no @ : / #).
# Generate one with: openssl rand -hex 24
VALKEY_PASSWORD=3f9a1c7e5b2d8f4a6c0e9b1d7f3a5c8e2b4d6f0a1c3e5b7d

# For reference, compose turns these into:
#   DATABASE_URL=postgres://postgres:mypassword@pgbouncer:6432/postgres
#   VALKEY_URL=redis://:3f9a1c7e5b2d8f4a6c0e9b1d7f3a5c8e2b4d6f0a1c3e5b7d@valkey:6379
#
# Only for running the dashboard outside Docker (bun run dash:dev), put this in
# apps/dashboard/.env, with localhost instead of valkey:
#   VALKEY_URL=redis://:3f9a1c7e5b2d8f4a6c0e9b1d7f3a5c8e2b4d6f0a1c3e5b7d@localhost:6379
