{
  "name": "jessjessbot",
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "prettier": "^3.8.1"
  },
  "packageManager": "bun@1.3.11",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "check": "bun run --cwd ./packages/db check-types && bun run --cwd ./apps/dashboard check-types && bun run --cwd ./apps/bot check-types",
    "db:generate": "bun run --cwd ./packages/db db:generate",
    "db:migrate": "bun run --cwd ./packages/db db:migrate",
    "dash:dev": "bun run --cwd ./apps/dashboard dev",
    "dash:prepare": "bun run --cwd ./apps/dashboard prepare",
    "dash:build": "bun run --cwd ./apps/dashboard build",
    "dash:preview": "bun run --cwd ./apps/dashboard preview",
    "bot:start": "bun run --cwd ./apps/bot start"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
