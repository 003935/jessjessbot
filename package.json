{
	"name": "jessjessbot",
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"prettier": "^3.9.6"
	},
	"packageManager": "bun@1.3.11",
	"private": true,
	"scripts": {
		"format": "prettier --write .",
		"check": "bun run --cwd ./packages/database check && bun run --cwd ./apps/dashboard check && bun run --cwd ./apps/bot check && bun run --cwd ./packages/discord-api check && bun run --cwd ./packages/valkey check",
		"db:generate": "bun run --cwd ./packages/database db:generate",
		"db:migrate": "bun run --cwd ./packages/database db:migrate",
		"dash:dev": "bun run --cwd ./apps/dashboard dev",
		"dash:prepare": "bun run --cwd ./apps/dashboard prepare",
		"dash:build": "bun run --cwd ./apps/dashboard build",
		"dash:preview": "bun run --cwd ./apps/dashboard preview",
		"bot:start": "bun run --cwd ./apps/bot start"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
